{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability set for the main window. Every permission added here must be justified by a command that actually ships.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "deep-link:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/xlongDev/ColorReader*" },
        { "url": "https://*.wikipedia.org/wiki/*" }
      ]
    }
  ]
}
